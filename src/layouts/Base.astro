---
import '../styles/global.css';
import { loadMeta } from '../lib/data';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'How concentrated are global emissions? A leaderboard of the producers behind them.' } = Astro.props;
const meta = loadMeta();
const sampleSources = meta.sources.filter((s) => s.isSample).map((s) => (s.id === 'carbon_majors' ? 'producer' : 'country'));
const pageTitle = title === 'Home' ? 'Carbon Majors Leaderboard' : `${title} · Carbon Majors Leaderboard`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <script is:inline>
      // Apply the saved theme before first paint so the page never flashes the wrong one.
      try {
        if (localStorage.getItem('theme') === 'light') document.documentElement.dataset.theme = 'light';
      } catch {}
    </script>
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>

    {meta.dataSource === 'sample' && (
      <div class="sample-banner" role="note">
        Showing <strong>synthetic sample data</strong> for {sampleSources.join(' and ')} figures. Names and numbers
        there are invented. Add the real downloads to <code>data/raw/</code> before publishing.
      </div>
    )}

    <header class="site-header">
      <div class="container">
        <a href="/" class="wordmark">Carbon Majors</a>
        <nav aria-label="Main">
          <a href="/leaderboard">Leaderboard</a>
          <a href="/methodology">How we calculated this</a>
          <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to light theme">
            <span class="to-light" aria-hidden="true">☀ Light</span>
            <span class="to-dark" aria-hidden="true">☾ Dark</span>
          </button>
        </nav>
      </div>
    </header>

    <main id="main" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          Producer emissions: <a href="https://carbonmajors.org">Carbon Majors database</a>, InfluenceMap
          (non-commercial use). Per-capita emissions: <a href="https://ourworldindata.org/co2-and-greenhouse-gas-emissions">Our World in Data</a>
          (CC BY 4.0), based on the Global Carbon Project.
        </p>
        <p class="built">Data built {new Date(meta.builtAt).toLocaleDateString('en-US', { dateStyle: 'medium' })}.</p>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const btn = document.getElementById('theme-toggle')!;
      const sync = () => {
        const light = root.dataset.theme === 'light';
        btn.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
      };
      btn.addEventListener('click', () => {
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
        sync();
      });
      sync();
    </script>
  </body>
</html>

<style>
  .sample-banner {
    background: var(--accent-soft);
    color: var(--text);
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    text-align: center;
  }
  .site-header { border-bottom: 1px solid var(--border); }
  .site-header .container {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; padding-block: 1rem; flex-wrap: wrap;
  }
  .theme-toggle {
    font: inherit; font-size: 0.85rem; color: var(--text); background: var(--surface);
    border: 1px solid var(--border); border-radius: 999px; padding: 0.2rem 0.75rem; cursor: pointer;
  }
  .theme-toggle:hover { border-color: var(--text-muted); }
  .theme-toggle .to-dark { display: none; }
  :global(:root[data-theme='light']) .theme-toggle .to-light { display: none; }
  :global(:root[data-theme='light']) .theme-toggle .to-dark { display: inline; }
  nav { align-items: center; }
  .wordmark { font-weight: 600; text-decoration: none; }
  nav { display: flex; gap: 1.25rem; font-size: 0.95rem; }
  main { padding-block: 2.5rem 4rem; }
  .site-footer {
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.85rem;
    padding-block: 1.5rem;
  }
  .built { margin-bottom: 0; }
</style>
