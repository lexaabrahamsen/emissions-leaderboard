---
import type { Commodity } from '../../../pipeline/types.ts';
import EntityLabel from '../../components/EntityLabel';
import Base from '../../layouts/Base.astro';
import { loadEntities, loadEntity, loadMeta } from '../../lib/data';
import { COMMODITY_LABEL, ENTITY_TYPE_LABEL, formatMt } from '../../lib/format';

export function getStaticPaths() {
  return loadEntities().map((e) => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const entity = loadEntity(slug!);
const meta = loadMeta();
const latest = entity.series[entity.series.length - 1];

// Server-rendered area chart: zero JS. Replaced by a visx stacked area in milestone 3.
const W = 720;
const H = 220;
const PAD = { top: 12, right: 12, bottom: 28, left: 56 };
const xs = entity.series.map((s) => s.year);
const maxY = Math.max(...entity.series.map((s) => s.totalMtCO2e)) || 1;
const x = (yr: number) =>
  PAD.left + ((yr - xs[0]) / Math.max(1, xs[xs.length - 1] - xs[0])) * (W - PAD.left - PAD.right);
const y = (v: number) => H - PAD.bottom - (v / maxY) * (H - PAD.top - PAD.bottom);
const line = entity.series.map((s, i) => `${i ? 'L' : 'M'}${x(s.year).toFixed(1)},${y(s.totalMtCO2e).toFixed(1)}`).join('');
const area = `${line}L${x(xs[xs.length - 1]).toFixed(1)},${y(0)}L${x(xs[0]).toFixed(1)},${y(0)}Z`;
const yTicks = [0, maxY / 2, maxY];
const xTicks = [...new Set([xs[0], Math.round((xs[0] + xs[xs.length - 1]) / 2), xs[xs.length - 1]])];

const recent = entity.series.slice(-10).reverse();
---

<Base title={entity.name} description={`${entity.name}: emissions ${entity.firstYear}–${entity.lastYear} from the Carbon Majors database.`}>
  <p class="crumb"><a href="/leaderboard">← Leaderboard</a></p>
  <h1><EntityLabel name={entity.name} logo={entity.logo} country={entity.country} /></h1>
  <p class="type">{ENTITY_TYPE_LABEL[entity.type]} · {entity.commodities.map((c: Commodity) => COMMODITY_LABEL[c]).join(', ')}</p>

  <dl class="stats">
    <div>
      <dt>Cumulative emissions, {entity.firstYear}–{entity.lastYear}</dt>
      <dd class="num">{formatMt(entity.cumulativeMtCO2e)}</dd>
    </div>
    <div>
      <dt>Rank by cumulative emissions</dt>
      <dd class="num">#{entity.rankCumulative} <span class="of">of {meta.entityCount}</span></dd>
    </div>
    <div>
      <dt>Emissions in {latest.year}</dt>
      <dd class="num">{formatMt(latest.totalMtCO2e)}</dd>
    </div>
  </dl>

  <section aria-labelledby="chart-heading">
    <h2 id="chart-heading">Emissions over time</h2>
    <figure>
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="chart-title chart-desc" class="chart">
        <title id="chart-title">{entity.name} annual emissions, {entity.firstYear}–{entity.lastYear}</title>
        <desc id="chart-desc">
          Peak of {formatMt(maxY)} per year. {latest.year}: {formatMt(latest.totalMtCO2e)}. Full figures in the table below.
        </desc>
        {yTicks.map((t) => (
          <g>
            <line x1={PAD.left} x2={W - PAD.right} y1={y(t)} y2={y(t)} class="grid" />
            <text x={PAD.left - 8} y={y(t)} class="tick" text-anchor="end" dominant-baseline="middle">{formatMt(t)}</text>
          </g>
        ))}
        {xTicks.map((t) => (
          <text x={x(t)} y={H - 8} class="tick" text-anchor="middle">{t}</text>
        ))}
        <path d={area} class="area" />
        <path d={line} class="line" />
      </svg>
      <figcaption>Annual emissions, all commodities, Mt CO₂e. Source: Carbon Majors (InfluenceMap).</figcaption>
    </figure>
  </section>

  <details>
    <summary>Last 10 years by commodity</summary>
    <table>
      <thead>
        <tr>
          <th scope="col">Year</th>
          {entity.commodities.map((c: Commodity) => <th scope="col" class="r">{COMMODITY_LABEL[c]}</th>)}
          <th scope="col" class="r">Total</th>
        </tr>
      </thead>
      <tbody>
        {recent.map((s) => (
          <tr>
            <th scope="row">{s.year}</th>
            {entity.commodities.map((c: Commodity) => <td class="r num">{formatMt(s.byCommodity[c] ?? 0)}</td>)}
            <td class="r num">{formatMt(s.totalMtCO2e)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>

  <!-- TODO(milestone 3c): Climate TRACE facility map for entities with a verified crosswalk match. -->
  <!-- TODO(milestone 4): "Compare to your footprint" CTA, prefilled with this company. -->
</Base>

<style>
  .crumb { margin: 0 0 1rem; font-size: 0.9rem; }
  h1 { margin: 0; }
  .type { color: var(--text-muted); margin-top: 0.25rem; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 1rem; margin: 2rem 0; }
  .stats div { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  dt { color: var(--text-muted); font-size: 0.85rem; }
  dd { margin: 0.25rem 0 0; font-size: 1.6rem; font-weight: 600; }
  .of { font-size: 0.9rem; font-weight: 400; color: var(--text-muted); }
  figure { margin: 0; }
  .chart { width: 100%; height: auto; }
  .chart .grid { stroke: var(--border); stroke-width: 1; }
  .chart .tick { fill: var(--text-muted); font-size: 11px; }
  .chart .area { fill: var(--accent-soft); }
  .chart .line { fill: none; stroke: var(--accent); stroke-width: 2; }
  figcaption { color: var(--text-muted); font-size: 0.85rem; }
  details { margin-top: 2rem; }
  summary { cursor: pointer; font-weight: 500; }
  table { border-collapse: collapse; margin-top: 1rem; font-size: 0.9rem; }
  th, td { padding: 0.4rem 0.75rem; border-bottom: 1px solid var(--border); text-align: left; }
  .r { text-align: right; }
</style>
