---
import Base from '../layouts/Base.astro';
import { loadLeaderboard, loadMeta } from '../lib/data';
import { formatMt, formatPct } from '../lib/format';

const meta = loadMeta();
const c = meta.concentration;
const latest = loadLeaderboard(meta.latestYear);
const top = latest.rows.slice(0, 5);
---

<Base title="Home">
  <section class="hero" aria-labelledby="hero-heading">
    <p class="eyebrow">{meta.latestYear}</p>
    {c.entitiesForHalf > 0 ? (
      <h1 id="hero-heading">
        <span class="big num">{c.entitiesForHalf}</span> producers account for half of the world's fossil
        fuel and cement emissions.
      </h1>
    ) : (
      <h1 id="hero-heading">A leaderboard of the producers behind global emissions.</h1>
    )}
    <p class="lede">
      {meta.entityCount} oil, gas, coal, and cement producers are tracked here. Their combined annual
      emissions in {meta.latestYear}: <strong class="num">{formatMt(latest.totalAnnualMtCO2e)} CO₂e</strong>.
    </p>
    <!-- TODO(milestone 6): replace with the waffle/unit chart hero. Copy should cite InfluenceMap's own published figure. -->
    <a class="cta" href="/leaderboard">See the full leaderboard →</a>
  </section>

  <section aria-labelledby="top-heading">
    <h2 id="top-heading">Largest emitters in {meta.latestYear}</h2>
    <ol class="top-list">
      {top.map((r) => (
        <li>
          <a href={`/companies/${r.slug}`}>{r.name}</a>
          <span class="num">{formatMt(r.annualMtCO2e)}</span>
          <span class="share num">{formatPct(r.annualMtCO2e / c.denominatorMt)}</span>
        </li>
      ))}
    </ol>
    <p class="note">
      Share column uses {c.denominator === 'owid_world_co2' ? 'global fossil and industry CO₂ (OWID)' : 'the Carbon Majors total'} as the
      denominator. <a href="/methodology">Why that matters</a>.
    </p>
  </section>
</Base>

<style>
  .hero { padding-block: 2rem 3rem; max-width: 46rem; }
  .eyebrow { color: var(--text-muted); font-size: 0.875rem; letter-spacing: 0.04em; margin: 0; }
  h1 { font-size: clamp(1.75rem, 4vw, 2.75rem); line-height: 1.2; margin: 0.5rem 0 1rem; font-weight: 600; }
  .big { color: var(--accent); }
  .lede { font-size: 1.125rem; color: var(--text-muted); }
  .cta {
    display: inline-block; margin-top: 1rem; padding: 0.6rem 1rem;
    border: 1px solid var(--text); border-radius: var(--radius); text-decoration: none; font-weight: 500;
  }
  .top-list { padding: 0; list-style: none; counter-reset: rank; max-width: 40rem; }
  .top-list li {
    counter-increment: rank;
    display: grid; grid-template-columns: 2rem 1fr auto 4rem; gap: 0.75rem;
    padding: 0.6rem 0; border-bottom: 1px solid var(--border); align-items: baseline;
  }
  .top-list li::before { content: counter(rank); color: var(--text-muted); }
  .share { color: var(--text-muted); text-align: right; }
  .note { color: var(--text-muted); font-size: 0.875rem; }
</style>
